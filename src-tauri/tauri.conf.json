{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DocCraft",
  "version": "0.3.0",
  "identifier": "com.doccraft.app",
  "mainBinaryName": "DocCraft",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DocCraft",
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "width": 1080,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/installer-hooks.nsh",
        "languages": ["English", "SimpChinese"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4MDk5N0E5QUE5RjJEMzUKUldRMUxaK3FxWmNKR0tUN2NuNDladml1TFJkeERGWnY0ZkVNY1d5MGIwV2xtdjhGaFhSeUdlQ0oK",
      "endpoints": [
        "https://github.com/tansen87/DocCraft/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
